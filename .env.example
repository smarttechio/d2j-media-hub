# ==============================================================================
# D2J Media Hub — Production Environment Variables Template
# Copy this file to .env.local (for local overrides) or set these in your
# hosting provider's Environment Variables dashboard (Vercel / Render / VPS).
# ==============================================================================

# 1. Public Canonical Site URL (used by sitemap.xml, robots.txt, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://d2jmediahub.com

# 2. HMAC-SHA256 Secret for HTTP-Only Editorial Session Cookies
# Generate a strong random secret (e.g., `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` )
D2J_SESSION_SECRET=replace_with_64_char_random_hex_secret

# 3. Initial Super Admin & Staff Credentials
D2J_ADMIN_EMAIL=admin@d2jmediahub.com
D2J_ADMIN_PASSWORD=replace_with_strong_super_admin_password

D2J_EDITOR_EMAIL=editor@d2jmediahub.com
D2J_EDITOR_PASSWORD=replace_with_strong_editor_password

D2J_CONTRIBUTOR_EMAIL=campus@d2jmediahub.com
D2J_CONTRIBUTOR_PASSWORD=replace_with_strong_contributor_password

D2J_SCHOLAR_EMAIL=scholars@d2jmediahub.com
D2J_SCHOLAR_PASSWORD=replace_with_strong_scholar_password
